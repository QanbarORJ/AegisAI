# =============================================================================
# AegisAI — Environment Configuration Template
# Copy this file to .env and customize for your environment.
# =============================================================================

# Application Environment: development | staging | production | test
AEGIS_ENV=development
AEGIS_APP_NAME="AegisAI Security Assessment Platform"
AEGIS_API_V1_PREFIX=/api/v1
AEGIS_LOG_LEVEL=INFO

# Database Configuration
# Production / Docker Compose uses PostgreSQL 16:
# DATABASE_URL=postgresql+psycopg://aegis:aegis_secure_password@localhost:5432/aegis_db
# Local zero-config development & automated test fallback:
DATABASE_URL=sqlite:///./aegis_local.db

# Redis & Job Runner Configuration
REDIS_URL=redis://localhost:6379/0
# Runner mode: in_process (async task runner) | redis_queue (distributed worker)
AEGIS_RUNNER_MODE=in_process

# Security & Authentication (MUST be overridden in production)
AEGIS_JWT_SECRET_KEY=change-this-in-production-to-a-64-char-high-entropy-secret-key-01
AEGIS_JWT_ALGORITHM=HS256
AEGIS_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Envelope Credential Encryption Master Key (32+ bytes hex or base64 recommended)
AEGIS_MASTER_ENCRYPTION_KEY=aegis-dev-master-key-change-in-production-32bytes-9f8a7b6c5d4e3f

# Outbound SSRF & Rate Limiting Defaults
AEGIS_ALLOW_ISOLATED_LOCAL_TARGETS=false
AEGIS_ALLOWED_LOCAL_HOSTS=localhost,127.0.0.1,target-sim
AEGIS_DEFAULT_MAX_RPS=2.0
AEGIS_DEFAULT_REQUEST_TIMEOUT_SECONDS=15
AEGIS_MAX_RESPONSE_BYTES=524288
AEGIS_MAX_REQUESTS_PER_ASSESSMENT=50

# CORS Allowed Origins (comma-separated)
AEGIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Public API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
